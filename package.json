{
  "name": "ritro-virtual-temple",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"RITRO_PORT=8787 node --watch server/index.mjs\" \"vite\"",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
