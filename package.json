{
  "name": "webuddhist-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p dist && concurrently -k -n worker,web -c yellow,cyan \"wrangler dev --port 8787\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "studio": "vite --open /__studio",
    "statues": "node --experimental-strip-types --no-warnings scripts/statues/build.ts",
    "mocap": "node --experimental-strip-types --no-warnings scripts/mocap/build.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "wrangler": "^4.156.2"
  }
}
